# Numéro WhatsApp du cabinet, au format international, sans "+" ni espaces.
# Par défaut : 237655030815 (défini dans src/content/site.ts). À renseigner seulement pour le changer.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Adresse publique du site (sert aux balises SEO, au sitemap et au robots.txt).
# Sur Vercel, l'adresse de production est utilisée automatiquement si cette variable est vide.
# À renseigner une fois le nom de domaine du cabinet branché, ex. https://www.geobati.cm
NEXT_PUBLIC_SITE_URL=

# Affiche les notes « à valider » sur le site (utile pour une préversion client).
# Par défaut, elles ne s'affichent qu'en développement.
NEXT_PUBLIC_SHOW_DRAFT_NOTES=false
