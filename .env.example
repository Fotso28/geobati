# Numéro WhatsApp du cabinet, au format international, sans "+" ni espaces.
# Exemple : 2376XXXXXXXX
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Adresse publique du site (sert aux balises SEO, au sitemap et au robots.txt).
NEXT_PUBLIC_SITE_URL=https://www.exemple.cm

# Affiche les notes « à valider » sur le site (utile pour une préversion client).
# Par défaut, elles ne s'affichent qu'en développement.
NEXT_PUBLIC_SHOW_DRAFT_NOTES=false
